# Copy this file to .env.local. These are the real production values —
# set the same ones in Vercel: Project Settings → Environment Variables.

# WhatsApp number in international format, digits only (no +, no spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=381677747710

# Telegram handle (without @)
NEXT_PUBLIC_TELEGRAM_HANDLE=svojsmestaj

# Contact phone (as displayed) and email
NEXT_PUBLIC_CONTACT_PHONE=+381 67 774 7710
NEXT_PUBLIC_CONTACT_EMAIL=svojsmestaj@gmail.com

# Instagram URL
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/svojsmestaj

# Live example site shown to visitors from the hero
NEXT_PUBLIC_EXAMPLE_SITE_URL=https://primersajta.vercel.app/

# Full production URL (used for sitemap.xml, canonical + hreflang tags, OG tags)
NEXT_PUBLIC_SITE_URL=https://svojsmestaj.com

# Google Ads. The ID is baked in as a default; the conversion label is the part
# after the slash in the snippet's send_to, e.g. AW-868270889/AbCdEfGhIjKl.
# Without the label the tag loads but no conversion is reported.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-868270889
NEXT_PUBLIC_GOOGLE_ADS_LABEL_CONTACT=
