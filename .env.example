# Copy this file to .env.local and fill in real values before deploying.

# WhatsApp number in international format, digits only (no +, no spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=381600000000

# Telegram handle (without @)
NEXT_PUBLIC_TELEGRAM_HANDLE=mojsmestaj

# Contact phone (as displayed) and email
NEXT_PUBLIC_CONTACT_PHONE=+381 60 000 0000
NEXT_PUBLIC_CONTACT_EMAIL=info@mojsmestaj.rs

# Instagram URL
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/

# Full production URL (used for sitemap.xml, canonical + hreflang tags, OG tags)
NEXT_PUBLIC_SITE_URL=https://mojsmestaj.rs
